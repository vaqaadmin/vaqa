---
const navItems = [
	{ href: '/', label: 'Home' },
	{ href: '/advisory', label: 'Advisory' },
	{ href: '/about', label: 'About' },
	{ href: '/blog', label: 'Blog' },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-vaqa-ink/10">
	<div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-5">
		<a href="/" class="font-sans text-lg font-semibold tracking-tight text-vaqa-ink">
			Tom Batting
		</a>
		<nav class="flex items-center gap-8">
			{navItems.map((item) => {
				const isActive =
					item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
				return (
					<a
						href={item.href}
						class:list={[
							'font-sans text-sm transition-colors',
							isActive ? 'text-vaqa-ink font-medium' : 'text-vaqa-ink/60 hover:text-vaqa-ink',
						]}
					>
						{item.label}
					</a>
				);
			})}
			<a
				href="mailto:tom@vaqa.co.uk"
				class="font-sans text-sm font-medium rounded-full bg-vaqa-ink px-4 py-2 text-white transition-colors hover:bg-vaqa-teal"
			>
				Get in touch
			</a>
		</nav>
	</div>
</header>
