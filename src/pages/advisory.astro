---
import Layout from '../layouts/Layout.astro';
import { advisoryTopics } from '../data/advisory.ts';
import { SectionHeading } from '../design-system/components/core/SectionHeading.jsx';
import { Eyebrow } from '../design-system/components/core/Eyebrow.jsx';
---

<Layout
	title="Advisory | Tom Batting"
	description="Board advisory, growth, go-to-market, AI implementation, operational efficiency, and finance and fundraising advice from Tom Batting."
>
	<main>
		<section style="background:var(--surface-page);">
			<div
				class="mx-auto max-w-[var(--container-max)]"
				style="padding:var(--space-10) var(--gutter) var(--space-6);"
			>
				<SectionHeading
					client:load
					eyebrow="Advisory"
					title="Six areas, one operator's perspective"
					lede="I work with founders and leadership teams across the following areas, drawing on first-hand experience building, scaling and exiting my own ventures."
				/>
			</div>
		</section>

		<section
			class="mx-auto max-w-[var(--container-max)]"
			style="padding:0 var(--gutter) var(--section-y);border-top:var(--border-hairline) solid var(--border-subtle);"
		>
			{advisoryTopics.map((topic) => (
				<div
					id={topic.slug}
					class="scroll-mt-24"
					style="padding:var(--space-8) 0;border-bottom:var(--border-hairline) solid var(--border-subtle);"
				>
					<Eyebrow client:load>{topic.title}</Eyebrow>
					<p
						class="mt-4 max-w-2xl"
						style="font-size:var(--text-body-lg);font-weight:var(--weight-light);line-height:var(--leading-loose);color:var(--text-secondary);"
					>
						{topic.description}
					</p>
				</div>
			))}
		</section>
	</main>
</Layout>
