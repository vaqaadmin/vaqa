---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SectionHeading } from '../../design-system/components/core/SectionHeading.jsx';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' });
---

<Layout
	title="Blog | Tom Batting"
	description="Opinions on AI, growth, and building businesses from Tom Batting."
>
	<main>
		<section style="background:var(--surface-page);">
			<div
				class="mx-auto max-w-[var(--container-narrow)]"
				style="padding:var(--space-10) var(--gutter) var(--space-6);"
			>
				<SectionHeading
					client:load
					eyebrow="Blog"
					title="Opinions on AI, and everything else"
					lede="Where I write about what's happening in AI, and other industries I keep an eye on."
				/>
			</div>
		</section>

		<section
			class="mx-auto max-w-[var(--container-narrow)]"
			style="padding:0 var(--gutter) var(--section-y);border-top:var(--border-hairline) solid var(--border-subtle);"
		>
			{posts.length === 0 && (
				<p style="padding:var(--space-6) 0;color:var(--text-muted);">No posts yet, check back soon.</p>
			)}
			{posts.map((post) => (
				<a
					href={`/blog/${post.id}`}
					class="group block"
					style="padding:var(--space-6) 0;border-bottom:var(--border-hairline) solid var(--border-subtle);text-decoration:none;"
				>
					<p style="font-size:var(--text-caption);color:var(--text-muted);">
						{dateFormatter.format(post.data.pubDate)}
					</p>
					<h2
						class="mt-1 group-hover:opacity-70"
						style="font-size:var(--text-h3);color:var(--text-primary);"
					>
						{post.data.title}
					</h2>
					<p
						class="mt-2"
						style="font-weight:var(--weight-light);line-height:var(--leading-loose);color:var(--text-secondary);"
					>
						{post.data.description}
					</p>
				</a>
			))}
		</section>
	</main>
</Layout>
