---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { parseFaqs } from '../../utils/faq.ts';
import { SectionHeading } from '../../design-system/components/core/SectionHeading.jsx';
import { InsightCard } from '../../design-system/components/content/InsightCard.jsx';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, allPosts: posts },
	}));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' });

const faqs = parseFaqs(post.body ?? '');

const canonicalURL = new URL(`/blog/${post.id}`, Astro.site).toString();

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', Astro.site).toString() },
		{ '@type': 'ListItem', position: 3, name: post.data.title, item: canonicalURL },
	],
};

const blogPostingSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.data.title,
	description: post.data.description,
	datePublished: post.data.pubDate.toISOString(),
	dateModified: post.data.pubDate.toISOString(),
	url: canonicalURL,
	mainEntityOfPage: canonicalURL,
	author: { '@id': 'https://vaqa.co.uk/#person' },
	publisher: { '@id': 'https://vaqa.co.uk/#person' },
	image: new URL('/images/vaqa/og-image.jpg', Astro.site).toString(),
};

const faqSchema =
	faqs.length > 0
		? {
				'@context': 'https://schema.org',
				'@type': 'FAQPage',
				mainEntity: faqs.map((faq) => ({
					'@type': 'Question',
					name: faq.question,
					acceptedAnswer: { '@type': 'Answer', text: faq.answer },
				})),
			}
		: null;

const schema = [breadcrumbSchema, blogPostingSchema, ...(faqSchema ? [faqSchema] : [])];

// Related posts: prefer shared tags, then fall back to most recent, excluding this post.
const others = allPosts.filter((p) => p.id !== post.id);
const shareTag = (p: (typeof others)[number]) => p.data.tags.some((t) => post.data.tags.includes(t));
const related = [...others.filter(shareTag), ...others.filter((p) => !shareTag(p))]
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.filter((p, i, arr) => arr.findIndex((x) => x.id === p.id) === i)
	.slice(0, 3);
// Re-sort the chosen set by relevance (shared tag first), keeping recency as the tiebreaker.
related.sort((a, b) => Number(shareTag(b)) - Number(shareTag(a)));
---

<Layout
	title={`${post.data.title} | Tom Batting`}
	description={post.data.description}
	ogType="article"
	publishedTime={post.data.pubDate}
	schema={schema}
>
	<main>
		<article
			class="mx-auto max-w-[var(--container-narrow)]"
			style="padding:var(--space-10) var(--gutter) var(--space-10);"
		>
			<p style="font-size:var(--text-caption);color:var(--text-muted);">
				{dateFormatter.format(post.data.pubDate)}
			</p>
			<h1 class="mt-2" style="font-size:var(--text-h1);color:var(--text-primary);">
				{post.data.title}
			</h1>
			<div class="prose prose-lg mt-10 max-w-none" style="font-family:var(--font-body);">
				<Content />
			</div>
		</article>

		{related.length > 0 && (
			<section style="background:var(--surface-muted);">
				<div
					class="mx-auto max-w-[var(--container-max)]"
					style="padding:var(--section-y) var(--gutter);"
				>
					<SectionHeading client:load eyebrow="Blog" title="More from the blog" />
					<div
						class="mt-10 grid gap-[var(--grid-gap)]"
						style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr));"
					>
						{related.map((p) => (
							<InsightCard
								client:load
								href={`/blog/${p.id}`}
								title={p.data.title}
								body={p.data.description}
								date={dateFormatter.format(p.data.pubDate)}
							/>
						))}
					</div>
				</div>
			</section>
		)}
	</main>
</Layout>
